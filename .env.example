# PostgreSQL (docker-compose db service)
POSTGRES_USER=archiveuser
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=archivedb

# Application database URL (async, used by FastAPI inside Docker)
DATABASE_URL=postgresql+asyncpg://archiveuser:change_me_in_production@db:5432/archivedb

# Dev only: Alembic / psql from host (docker-compose.dev.yaml exposes db port)
POSTGRES_HOST_PORT=5433
# Leave unset for Docker production — migrations use DATABASE_URL (host db) automatically.
# Uncomment only for running alembic from the host machine:
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://archiveuser:change_me_in_production@localhost:5433/archivedb

# JWT auth — generate with: openssl rand -hex 32
SECRET_KEY=replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File storage — path on HOST machine, mounted into container as /app/uploaded_files
# Use forward slashes. Relative paths work on Windows and Linux.
UPLOAD_DIR=uploaded_files
UPLOAD_HOST_PATH=./data/uploads

# Windows absolute path example (Docker Desktop):
# UPLOAD_HOST_PATH=C:/archive/data/uploads
# Linux absolute path example:
# UPLOAD_HOST_PATH=/var/archive/uploads

MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.png,.jpg,.jpeg,.tif,.tiff,.dwg,.dxf

# SQL logging (true/false)
SQL_ECHO=false

# Production (set in docker-compose.yaml for api service)
AUTO_CREATE_TABLES=false
APP_BASE_PATH=/archive

# Reverse proxy
HTTP_PORT=80

# HTTPS later (optional)
DOMAIN=
LETSENCRYPT_EMAIL=

# Backup directory on host (relative or absolute; forward slashes on Windows)
BACKUP_DIR=./data/backups
BACKUP_RETENTION_DAYS=14

# Uvicorn workers in production entrypoint
UVICORN_WORKERS=2
