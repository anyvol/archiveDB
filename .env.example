# URL prefix when app is served behind reverse proxy (e.g. /archive)
ROOT_PATH=/archive

# PostgreSQL (docker-compose db service)
POSTGRES_USER=archiveuser
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=archivedb
# Host port mapped to container 5432 (change if 5433 is also taken)
POSTGRES_HOST_PORT=5433

# Application database URL (async, used by FastAPI inside Docker)
DATABASE_URL=postgresql+asyncpg://archiveuser:change_me_in_production@db:5432/archivedb

# Alembic sync URL — OPTIONAL.
# For "docker compose exec api alembic upgrade head" leave this commented out:
# Alembic will derive a sync URL from DATABASE_URL (@db:5432).
# Uncomment only for running alembic from the Windows/Linux host (localhost:POSTGRES_HOST_PORT):
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://archiveuser:change_me_in_production@localhost:5433/archivedb
# If password contains # or %, URL-encode them (# -> %23, % -> %25).

# JWT auth — generate with: openssl rand -hex 32
SECRET_KEY=replace_with_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# File storage (inside container; bind-mounted to host)
UPLOAD_DIR=uploaded_files
UPLOAD_HOST_PATH=./uploaded_files
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=.pdf,.doc,.docx,.png,.jpg,.jpeg,.tif,.tiff,.dwg,.dxf

# SQL logging (true/false)
SQL_ECHO=false

# Web Push (VAPID) — generate keys with: docker compose exec api python -m py_vapid --applicationServerKey
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com

# HTTPS (required for browser push outside localhost)
# Default HTTPS port is 8443 — port 443 is often blocked on WSL/Windows.
# Self-signed cert is auto-generated on first proxy start if nginx/certs/ is empty.
# SSL_CERT_CN=SERVER-PDM
# HTTP_PORT=80
# HTTPS_PORT=8443
