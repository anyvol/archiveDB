# HTTP — redirect to HTTPS (external port from PUBLIC_HTTPS_PORT)
server {
    listen 80;
    server_name _;

    location /archive/ {
        return 301 https://$host${REDIRECT_PORT}$request_uri;
    }

    location / {
        return 301 https://$host${REDIRECT_PORT}/archive/;
    }
}

# HTTPS — required for browser push notifications (Service Worker / Push API)
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location /archive/ {
        proxy_pass http://api:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
