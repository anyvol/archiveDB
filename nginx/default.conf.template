# HTTP for localhost — browsers treat localhost as secure; push works without HTTPS.
# Use http://localhost/archive/ from Windows when WSL does not forward port 8443.
server {
    listen 80;
    server_name localhost 127.0.0.1;

    location /archive/ {
        proxy_pass http://api:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }

    location / {
        return 302 /archive/;
    }
}

# HTTP — other hosts redirect to HTTPS (external port from PUBLIC_HTTPS_PORT)
server {
    listen 80 default_server;
    server_name _;

    location = /archive {
        return 301 https://$host${REDIRECT_PORT}/archive/;
    }

    location /archive/ {
        return 301 https://$host${REDIRECT_PORT}$request_uri;
    }

    location / {
        return 301 https://$host${REDIRECT_PORT}/archive/;
    }
}

# HTTPS — required for browser push on LAN hostnames (not localhost)
server {
    listen 443 ssl;
    server_name _;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    location = /archive {
        return 301 $scheme://$http_host/archive/;
    }

    location = / {
        return 301 $scheme://$http_host/archive/;
    }

    location /archive/ {
        proxy_pass http://api:8000/;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
